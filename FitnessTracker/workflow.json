    {
      "parameters": {
        "jsCode": "let user = $('Récup Infos Utilisateur').first().json;\nlet exercices = $('Récup Liste Exercices').all().map(e => e.json);\n\n// Calcul BMR (Mifflin-St Jeor)\nlet bmr = (user.sexe === 'Homme')\n  ? (10 * user.poids) + (6.25 * user.taille) - (5 * user.age) + 5\n  : (10 * user.poids) + (6.25 * user.taille) - (5 * user.age) - 161;\n\n// TDEE avec facteur activité modéré\nlet tdee = bmr * 1.4;\nlet calObj = tdee;\n\nswitch (user.objectif) {\n  case 'Perte de poids':             calObj = tdee * 0.80; break;\n  case 'Prise de masse':             calObj = tdee * 1.15; break;\n  case 'Restructuration corporelle': calObj = tdee * 0.95; break;\n  default:                           calObj = tdee; break;\n}\n\n// Enrichissement date\nconst now = new Date();\nconst jourSemaine = now.getDay(); // 0=dim, 1=lun ... 6=sam\nconst debutAnnee = new Date(now.getFullYear(), 0, 1);\nconst numSemaine = Math.ceil(((now - debutAnnee) / 86400000 + debutAnnee.getDay() + 1) / 7);\n\n// Phase de périodisation sur 3 semaines cycliques\nconst phases = ['montee', 'pic', 'decharge'];\nconst phaseHebdo = phases[numSemaine % 3];\n\n// Sélection du split selon jours disponibles\nconst jours = parseInt(user.jours_disponibilite);\nlet splitSelectionne;\nif (jours <= 2)      splitSelectionne = 'Full Body';\nelse if (jours === 3) splitSelectionne = 'Push / Pull / Legs';\nelse if (jours <= 5)  splitSelectionne = 'Upper / Lower';\nelse                  splitSelectionne = 'PPL 6 jours';\n\n// Exercices enrichis (nom + muscles + difficulté)\nconst listeExercicesDetails = exercices.map(e => `${e.nom} [${e.muscles}] (${e.difficulte})`).join(' | ');\nconst listeExercicesNoms = exercices.map(e => e.nom).join(', ');\n\nreturn {\n  json: {\n    ...user,\n    liste_exercices_dispo: listeExercicesNoms,\n    liste_exercices_details: listeExercicesDetails,\n    calc_calories:  Math.round(calObj),\n    calc_proteines: Math.round(user.poids * (user.objectif.includes('Restructuration') ? 2.2 : 2)),\n    calc_lipides:   Math.round(user.poids * 0.9),\n    calc_glucides:  Math.round((calObj - (user.poids * 2 * 4) - (user.poids * 0.9 * 9)) / 4),\n    jour_semaine:   jourSemaine,\n    num_semaine:    numSemaine,\n    phase_hebdo:    phaseHebdo,\n    split_selectionne: splitSelectionne\n  }\n};"
      },
