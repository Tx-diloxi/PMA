    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\n\nconst poids = parseFloat(data.poids) || 0;\nconst taille = parseFloat(data.taille) || 0;\nconst age = parseInt(data.age) || 0;\nconst sexe = data.sexe || 'Femme';\nconst jours = (data.jours || 'Lundi').split(',').map(s => s.trim()).filter(Boolean);\nconst user_id = data.user_id;\nconst date_fin = data.date_fin || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);\n\nconst bmr = 10 * poids + 6.25 * taille - 5 * age + (sexe === 'Homme' ? 5 : -161);\nconst nbJours = jours.length;\nconst facteurActivite = nbJours <= 2 ? 1.2 : nbJours <= 4 ? 1.375 : 1.55;\n\nconst calories = Math.round(bmr * facteurActivite);\nconst proteines = Math.round(poids * 2);\nconst lipides = Math.round((calories * 0.25) / 9);\nconst glucides = Math.round((calories - (proteines * 4 + lipides * 9)) / 4);\n\nconst joursMap = { Lundi: 1, Mardi: 2, Mercredi: 3, Jeudi: 4, Vendredi: 5, Samedi: 6, Dimanche: 0 };\nconst joursNums = jours.map(j => joursMap[j] || null).filter(n => n !== null);\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst endDate = new Date(`${date_fin}T00:00:00`);\nconst periodes = [];\n\nlet current = new Date(today);\nwhile (current <= endDate && periodes.length < 7) {\n  if (joursNums.includes(current.getDay())) {\n    periodes.push(current.toISOString().slice(0, 10));\n  }\n  current.setDate(current.getDate() + 1);\n}\n\nreturn [{\n  json: {\n    user_id,\n    calories_totales: calories,\n    proteines_g: proteines,\n    glucides_g: glucides,\n    lipides_g: lipides,\n    periodes,\n    joursNums,\n    poids,\n    age,\n    sexe\n  }\n}];"
      },
